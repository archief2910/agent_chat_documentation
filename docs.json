{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Agent Chat API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "errors"
        ]
      },
      {
        "group": "API",
        "pages": [
          "completions",
          "messages",
          "history",
          "runs",
          "tools",
          "uploads",
          "credits"
        ]
      },
      {
        "group": "Webhooks",
        "pages": [
          "webhooks"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "description": "Versioned API for agent conversations, Magica tool runs, and signed lifecycle webhooks.",
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ]
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      },
      "server": "https://agent-chat-backend-production.up.railway.app"
    }
  }
}
